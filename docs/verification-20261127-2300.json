  "diagnosis": {
    "priority": "P1 market integrity: ambiguous MIS stock observations / live coverage",
    "root_cause": "Individual stocks mutated official rows on the first valid quote and skipped later duplicates before checking whether executed price, previous close or time conflicted. Input order therefore changed live price while coverage remained inflated. TAIEX already rejected conflicting fingerprints.",
    "reproduction": "Five new methods expose six failing assertions/subtests; a two-stock case counted both stocks although one was conflicted. Reverse-order cases preserve the same rejection result after repair.",
    "repair": "Collect fully identity/date/time/price-validated candidates first; require one unique execution-date/time/previous-close/price fingerprint for each stock before mutation. Conflicted symbols retain official rows and do not count live. Identical flat/nested executions deduplicate; invalid/stale/wrong-market records do not poison valid quotes.",
    "paths_evaluated": [
      {
        "path": "Choose the newest valid duplicate",
        "finding": "Can resolve different-time ordering but not conflicting price or previous close at the same execution time; would infer unverified source truth."
      },
      {
        "path": "Reject ambiguous stocks before mutation, matching existing TAIEX policy",
        "finding": "Implemented and tested; preserves other valid stocks and existing low-coverage read-only safeguards."
      }
    ],
    "production_conflict_seen": false,
    "production_incident_attribution": "Not proven; synthetic source defect confirmed, no live production MIS conflict observed in this offhours round.",
    "tradeoff": "Ambiguous symbols can reduce coverage; never substitute their official close as a live trade."
  },
